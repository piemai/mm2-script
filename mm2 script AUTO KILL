--// Robust Coin Finder
local function getNearestCoin(hrp)
    local nearestCoin = nil
    local shortestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name
        if (name == "Coin_Server" or name == "Coin" or name == "CoinVisual" or name == "Gold") and obj:IsA("BasePart") and obj.Parent then
            if obj.Transparency < 1 then
                local dist = (hrp.Position - obj.Position).Magnitude
                if dist < shortestDist and dist < 350 then
                    shortestDist = dist
                    nearestCoin = obj
                end
            end
        end
    end
    return nearestCoin, shortestDist
end

