--// Safe Anti-Kick Tween Coin Farming Thread
task.spawn(function()
    while task.wait(0.05) do
        if autoCoinEnabled and not isGrabbingGun then
            local myChar = player.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                local targetCoin, dist = getNearestCoin(myHRP)
                if targetCoin then
                    local duration = math.clamp(dist / tweenFarmSpeed, 0.1, 2.5)
                    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                    local goal = { CFrame = CFrame.new(targetCoin.Position + Vector3.new(0, 1, 0)) }

                    activeCoinTween = TweenService:Create(myHRP, tweenInfo, goal)
                    activeCoinTween:Play()

                    local startTick = tick()
                    while tick() - startTick < duration do
                        if not autoCoinEnabled or isGrabbingGun or not targetCoin.Parent or targetCoin.Transparency >= 1 then
                            if activeCoinTween then
                                activeCoinTween:Cancel()
                            end
                            break
                        end
                        myHRP.AssemblyLinearVelocity = Vector3.zero
                        task.wait()
                    end
                else
                    task.wait(0.5)
                end
            end
        else
            if activeCoinTween then
                activeCoinTween:Cancel()
                activeCoinTween = nil
            end
        end
    end
end)

